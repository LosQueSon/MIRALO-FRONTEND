# Environment variables for MIRALO-FRONTEND

# Auth service URL (Google OAuth, /auth/me)
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3001

# Backend URL for REST API (used by server-side proxy)
BACKEND_URL=http://localhost:5000

# Backend URL for browser access (WebSocket, REST API from client-side)
# This is used for watch-party synchronization and real-time features
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Optional demo host id used by the discovery proxy when creating rooms
DEMO_HOST_ID=64b64c64b64c64b64c64c64c

# Production example:
# NEXT_PUBLIC_API_GATEWAY_URL=https://miralo-api-gateway-a9guhdgjenc4ahem.canadacentral-01.azurewebsites.net

# Optional Google Client ID for frontend-only integrations
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Do not include real secrets in this file.
# Real values should live in .env.local or deployment platform variables.
